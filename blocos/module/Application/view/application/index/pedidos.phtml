<link href="/css/select2.min.css" rel="stylesheet" />
<script src="/js/select2.min.js"></script>
<script type="text/javascript">
	$('body').on('focus', ".calendario", function() {

		$(this).datepicker({
			dateFormat: 'dd/mm/yy',
			dayNames: ['Domingo', 'Segunda', 'Terça', 'Quarta', 'Quinta', 'Sexta', 'Sábado'],
			dayNamesMin: ['D', 'S', 'T', 'Q', 'Q', 'S', 'S', 'D'],
			dayNamesShort: ['Dom', 'Seg', 'Ter', 'Qua', 'Qui', 'Sex', 'Sáb', 'Dom'],
			monthNames: ['Janeiro', 'Fevereiro', 'Março', 'Abril', 'Maio', 'Junho', 'Julho', 'Agosto', 'Setembro', 'Outubro', 'Novembro', 'Dezembro'],
			monthNamesShort: ['Jan', 'Fev', 'Mar', 'Abr', 'Mai', 'Jun', 'Jul', 'Ago', 'Set', 'Out', 'Nov', 'Dez'],
			nextText: 'Próximo',
			prevText: 'Anterior'
		});
	});

	function proximo() {
		// prevent action if button is hidden or disabled
		if (!$("#next").is(':visible') || $("#next").is('[disabled]')) return;
		$("#filtros").attr("action", "<?php echo $this->url('pedidos', array('offset' => $this->filtro['next'], 'situacao' => $this->filtro['situacao'])); ?>");
		$("#filtros").submit();
	}

	function anterior() {
		// prevent action if button is hidden or disabled
		if (!$("#anterior").is(':visible') || $("#anterior").is('[disabled]')) return;
		$("#filtros").attr("action", "<?= $this->url('pedidos', array('offset' => $this->filtro['preview'], 'situacao' => $this->filtro['situacao'])); ?>");
		$("#filtros").submit();
	}

	function HabDesmembrar(idvenda) {
		$(".qtd_desm_" + idvenda).show();
		$(".btn_desmembrar_" + idvenda).show();
		$(".btn_habilitardesmembrar_" + idvenda).hide();
	}

	function desmembrar(idvenda) {
		var produtos = [];
		$(".qtd_desm_" + idvenda).each(function() {
			produtos[$(this).attr("id")] = $(this).val();
		});

		var produtosLimpos = {};
		for (let key in produtos) {
			if (produtos[key] !== undefined && produtos[key] !== null && produtos[key] !== '') {
				produtosLimpos[key] = produtos[key];
			}
		}
		var jsonString = JSON.stringify(produtosLimpos);

		$.ajax({
			type: "POST",
			url: "<?php echo $this->url('desmembrar'); ?>",
			data: {
				prods: jsonString,
				idvenda: idvenda
			},
			success: function(data) {
				alert('Tramitado com sucesso!');
				document.location.reload(true);
			}
		});
	}
	$(document).ready(function() {

		const limite = <?= (int) ($this->filtro['limite'] ?? 50); ?>;
		const offset = <?= (int) ($this->filtro['offset'] ?? 0); ?>;
		const total = <?= (int) ($this->filtro['total'] ?? 0); ?>;
		const next = <?= (int) ($this->filtro['next'] ?? 0); ?>;
		const preview = <?= (int) ($this->filtro['preview'] ?? 0); ?>;

		$("#carga-modal").on('shown.bs.modal', function() {
			$.ajax({
				type: "POST",
				url: "<?php echo $this->url('carregarcargas'); ?>",
				success: function(data) {
					$('#cargas_lista').html(data);
				}
			});
		});

		$('#cidade').select2();
		$(".time").mask("99:99");

		$("#cpfcnpj").keydown(function() {

			var tamanho = $("#cpfcnpj").val().length;

			try {
				$("#cpfcnpj").unmask();
			} catch (e) {}


			if (tamanho < 12) {
				$("#cpfcnpj").mask("999.999.999-99");
			} else {
				$("#cpfcnpj").mask("99.999.999/9999-99");
			}

			// ajustando foco
			var elem = this;
			setTimeout(function() {
				// mudo a posição do seletor
				elem.selectionStart = elem.selectionEnd = 10000;
			}, 0);
			// reaplico o valor para mudar o foco
			var currentValue = $(this).val();
			$(this).val('');
			$(this).val(currentValue);
		});

		// Se mostrar todos → esconder ambos
		if (limite == 0) {
			$("#next, #anterior").hide();
		}

		// Primeira página
		if (offset <= 0) {
			$("#anterior").hide();
		}

		// Última página
		if (next >= total) {
			$("#next").hide();
		}

		$('#situacao').change(function() {
			var sit = $(this).val();
			$('#select_carga').val('');
			if (sit == "Carregamento" || sit == "Entrega") {
				$('#select_carga').prop("disabled", false);
				var temp = sit;
				$("#select_carga option").each(function() {
					if ($(this).attr("data-situ") == temp || $(this).val() == '') {
						$(this).show();
					} else {
						$(this).hide();
					}
				});
			} else {
				$('#select_carga').prop("disabled", true);
			}
		});

		$('#salvar_cargas').click(function() {
			var motorista = ($("#motorista_carga").val() ? String($("#motorista_carga").val()).trim() : '');
			var saida = ($("#saida").val() ? String($("#saida").val()).trim() : '');
			var saidah = ($("#saidah").val() ? String($("#saidah").val()).trim() : '');
			var retornoh = ($("#retornoh").length && $("#retornoh").val() ? String($("#retornoh").val()).trim() : '');
			var isEntrega = $("#situacao_carga").length ? $("#situacao_carga").is(':checked') : false;

			if (!motorista || !saida || !saidah) {
				alert("Todos os campos obrigatórios (Motorista, Data e Hora Saída) devem ser preenchidos!");
				return false;
			}

			$.ajax({
				type: "POST",
				data: {
					'motorista': motorista,
					'saida': saida,
					'saidah': saidah,
					'retornoh': retornoh,
					'situacao': isEntrega
				},
				url: "<?php echo $this->url('cadastrarcarga'); ?>",
				success: function(data) {
					var idNovo = String(data || '').trim();
					if (!idNovo) {
						alert("Erro ao cadastrar carga. Tente novamente.");
						return;
					}
					var situacao = isEntrega ? 'Entrega' : 'Carregamento';

					$('#carga-modal').modal('hide');
					$('.modal-backdrop').remove();

					// Define a situação e habilita o select de cargas
					$('#situacao').val(situacao);
					$('#select_carga').prop("disabled", false);

					// Adiciona e seleciona automaticamente a carga recém-criada
					var novaOpcao = $('<option>', {
						value: idNovo,
						text: motorista + " - " + saida + " " + saidah + " - " + situacao,
						'data-situ': situacao
					});
					$('#select_carga').append(novaOpcao);
					$('#select_carga').val(idNovo);

					// Limpa os campos do modal
					$("#motorista_carga").val('');
					$("#saida").val('');
					$("#saidah").val('');
					if ($("#retornoh").length) $("#retornoh").val('');

					$("#msg").addClass("alert alert-success").text("Carga cadastrada com sucesso e selecionada!");
				},
				error: function(xhr, status, error) {
					var msg = (xhr.responseText ? xhr.responseText : (error ? error : (status ? status : 'Erro desconhecido')));
					alert("Erro ao comunicar com o servidor ao cadastrar carga: " + msg);
				}
			});
		});

		$('#btn_tramitar').click(function(e) {
			var sit = $('#situacao').val();
			if (!sit) {
				alert("Selecione a situação!");
				return false;
			}

			var checadoCarga = false;
			$(".carga_tramitar:checked").each(function() {
				checadoCarga = true;
			});

			var checadoItem = false;
			$('.item_tramitar:checked').each(function() {
				checadoItem = true;
			});

			if (!checadoCarga && !checadoItem) {
				alert("Deve ser selecionado pelo menos um pedido ou uma carga para tramitar!");
				return false;
			}

			// Se selecionou pedidos individuais para Carregamento ou Entrega, exige seleção da Carga
			if (checadoItem && (sit == "Carregamento" || sit == "Entrega")) {
				if (!$('#select_carga').val()) {
					alert("Por favor, selecione uma carga no campo 'Cargas' para vincular aos pedidos!");
					$('#select_carga').focus();
					return false;
				}
			}

			$('#tramitar').submit();
		});

		$('body').on('click', ".venda", function() {
			if ($(this).hasClass('glyphicon-plus')) {
				$(this).removeClass('glyphicon-plus');
				$(this).addClass('glyphicon-minus');
				var id = "#tabela_prod_" + $(this).attr("id");
				$(id).show();

				var id_venda = $(this).attr("id");
				$('.asterisk').each(function() {
					if ($(this).attr('data-id') == id_venda) {
						$(this).hide();
						$.ajax({
							type: "GET",
							url: "<?php echo rtrim($this->url('abrir'), '/'); ?>/" + id_venda,
							success: function(data) {

							}
						});
					}

				});

			} else {
				$(this).removeClass('glyphicon-minus');
				$(this).addClass('glyphicon-plus');
				var id = "#tabela_prod_" + $(this).attr("id");
				$(id).hide();
			}
		});

		$('body').on('click', ".carga", function() {
			if ($(this).hasClass('glyphicon-plus')) {
				$(this).removeClass('glyphicon-plus');
				$(this).addClass('glyphicon-minus');
				var id = ".tabela_" + $(this).attr("id");
				$(id).show();
			} else {
				$(this).removeClass('glyphicon-minus');
				$(this).addClass('glyphicon-plus');
				var id = ".tabela_" + $(this).attr("id");
				$(id).hide();

				var idvenda = $(id).attr("data-id-venda");
				var idv = "#tabela_prod_" + idvenda;
				$(idv).hide();
			}
		});

	});
</script>