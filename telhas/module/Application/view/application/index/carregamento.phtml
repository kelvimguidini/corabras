<link href='/js/fullcalendar/lib/main.css' rel='stylesheet' />
<script src='/js/fullcalendar/lib/main.js'></script>
<script src='/js/fullcalendar/lib/locales/pt-br.js'></script>
<script>
    document.addEventListener('DOMContentLoaded', function() {
        var calendarEl = document.getElementById('calendar');

        var calendar = new FullCalendar.Calendar(calendarEl, {
            headerToolbar: {
                left: 'prev,next today',
                center: 'title',
                right: 'dayGridMonth,listMonth'
            },
            height: '100%',
            locale: 'pt-br',
            dayMaxEvents: true,
            navLinks: true,
            dayMaxEvents: true,
            businessHours: false, // display business hours
            expandRows: true,
            nowIndicator: false,

            eventClick: function(event, jsEvent, view) {

                $.ajax({
                    type: "POST",
                    url: "<?php echo $this->url('carregardadoscarga'); ?>/" + event.event.extendedProps.description,
                    success: function(data) {
                        $('#modalTitle').html(event.event.title);
                        $('#modalBody').html(data);
                        $('#fullCalModal').modal();
                    }
                });

            },

            events: [
                <?php
                if (!empty($this->carregamentos) && is_iterable($this->carregamentos)) {
                    foreach ($this->carregamentos as $carregamento) {
                        $data = $carregamento["data"] ?? null;
                        $saida = $carregamento["saida"] ?? null;
                        $retorno = $carregamento["retorno"] ?? null;
                        $motorista = $carregamento["motorista"] ?? 'Sem motorista';
                        $id = $carregamento["id"] ?? '';

                        if (!$data) {
                            continue;
                        }

                        $dataStr = ($data instanceof \DateTimeInterface) ? $data->format('Y-m-d') : (is_string($data) ? date('Y-m-d', strtotime($data)) : '');
                        if (!$dataStr) {
                            continue;
                        }

                        $saidaStr = ($saida instanceof \DateTimeInterface) ? $saida->format('H:i:s') : (is_string($saida) && !empty($saida) ? $saida : '00:00:00');
                        $retornoStr = ($retorno instanceof \DateTimeInterface) ? $retorno->format('H:i:s') : (is_string($retorno) && !empty($retorno) ? $retorno : $saidaStr);

                        $cores = [
                            'Fábio'  => 'blue',
                            'Jairo'  => 'pink',
                            'Cesar'  => 'red',
                            'Robson' => 'green',
                        ];
                        $cor = $cores[$motorista] ?? 'black';

                        $eventData = [
                            'title'       => $motorista,
                            'description' => (string) $id,
                            'start'       => $dataStr . 'T' . $saidaStr,
                            'end'         => $dataStr . 'T' . $retornoStr,
                            'color'       => $cor,
                        ];

                        echo json_encode($eventData) . ",\n";
                    }
                }
                ?>
            ]
        });

        calendar.render();
    });
</script>
<style>
    #calendar-container {
        position: fixed;
        top: 80px;
        left: 10px;
        right: 10px;
        bottom: 10px;
    }

    .fc-header-toolbar {
        /*
    the calendar will be butting up against the edges,
    but let's scoot in the header's buttons
    */
        padding-top: 1em;
        padding-left: 1em;
        padding-right: 1em;
    }
</style>
<div id='calendar-container'>
    <div id='calendar'></div>
</div>
<div id="fullCalModal" class="modal fade">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal"><span aria-hidden="true">×</span> <span class="sr-only">Fechar</span></button>
                <h4 id="modalTitle" class="modal-title"></h4>
            </div>
            <div id="modalBody" class="modal-body"></div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">Fechar</button>
            </div>
        </div>
    </div>
</div>

<script>
    $('body').on('click', ".venda", function() {
        if ($(this).hasClass('glyphicon-plus')) {
            $(this).removeClass('glyphicon-plus');
            $(this).addClass('glyphicon-minus');
            var id = "#tabela_prod_" + $(this).attr("id");
            $(id).show();
        } else {
            $(this).removeClass('glyphicon-minus');
            $(this).addClass('glyphicon-plus');
            var id = "#tabela_prod_" + $(this).attr("id");
            $(id).hide();
        }
    });
</script>